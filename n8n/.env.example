# Copy to n8n/.env and fill in. n8n/.env is git-ignored.

# Encrypts credentials stored inside n8n. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Shared HMAC secret. Must be the same value as LENDLOOP_WEBHOOK_SECRET on the Convex deployment.
# Generate with: openssl rand -hex 32
LENDLOOP_WEBHOOK_SECRET=

# Your Convex HTTP actions URL (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local), used by the reminder workflow.
CONVEX_SITE_URL=

# Public URL that Convex uses to reach this n8n (for example a tunnel URL). Leave empty for localhost.
N8N_PUBLIC_URL=

GENERIC_TIMEZONE=Europe/Zagreb
