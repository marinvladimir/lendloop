{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "n8n:up": "docker compose -f n8n/docker-compose.yml up -d",
    "n8n:import": "docker compose -f n8n/docker-compose.yml exec -T n8n sh -c 'n8n import:workflow --separate --input=/workflows && n8n publish:workflow --id=lendloopLoanEvent1 && n8n publish:workflow --id=lendloopOverdue01'"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "convex": "^1.49.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.72",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
