# Clerk (dashboard > API keys, or `npx clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (written automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set on the Convex deployment with `npx convex env set NAME value`, NOT here:
#   CLERK_JWT_ISSUER_DOMAIN     https://<your-instance>.clerk.accounts.dev
#   LENDLOOP_WEBHOOK_SECRET     shared HMAC secret, same value as in n8n/.env
#   N8N_LOAN_EVENT_WEBHOOK_URL  https://<public n8n url>/webhook/lendloop-loan-event
